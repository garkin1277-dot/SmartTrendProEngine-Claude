// ═══════════════════════════════════════════════════════════════════════════
// SMART TREND PRO ENGINE
// ═══════════════════════════════════════════════════════════════════════════
// PROFESSIONAL MODULAR TRADING ENGINE
// ─────────────────────────────────────────────────────────────────────────
// ARCHITECTURE (FROZEN):
//   CORE → DATA → DECISION → SIGNAL → EXECUTION → INTERFACE → FUTURE
// ─────────────────────────────────────────────────────────────────────────
// CURRENT LAYER IMPLEMENTED : SYSTEM CORE
// STATUS                    : Design → Implementation (Stage 2/5)
// NEXT LAYER                : DATA (LONG SETTINGS / SHORT SETTINGS)
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
strategy(
     title                = "Smart Trend Pro Engine"
   , shorttitle           = "STPE"
   , overlay              = true
   , max_bars_back        = 5000
   , calc_on_every_tick   = false
   , process_orders_on_close = true
   )

// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — DECLARATIONS
// ═══════════════════════════════════════════════════════════════════════════
// PURPOSE:
//   SYSTEM CORE stores ONLY system-level engine state: global flags,
//   bar/runtime state, data availability, fail-safe state and module
//   readiness. It NEVER stores trading logic (no LONG/SHORT signal state,
//   no filters, no risk, no AI/Smart Money calculations, no visuals).
//   All other layers consume this state; SYSTEM CORE consumes nothing.
// ═══════════════════════════════════════════════════════════════════════════

type SystemCore
    // ── Engine Information ──────────────────────────────────────────────
    string engineName
    string engineVersion

    // ── Runtime Information ─────────────────────────────────────────────
    bool   isRealtime
    bool   isHistorical

    // ── Bar State Information ───────────────────────────────────────────
    bool   isFirstBar
    bool   isLastBar
    bool   isNewBar
    int    barIndexCurrent

    // ── Data Availability Information ───────────────────────────────────
    bool   isDataReady
    bool   isMTFDataReady
    bool   isDataInvalid

    // ── Strategy State Information ──────────────────────────────────────
    bool   isLongEnabled
    bool   isShortEnabled
    bool   isStrategyEnabled
    bool   isExperimentalEngineEnabled

    // ── Global Execution Information ────────────────────────────────────
    bool   hasPosition
    string positionDirection
    float  positionSize
    bool   isFlat

    // ── Fail Safe Information ───────────────────────────────────────────
    bool   isFailSafeTriggered
    bool   isNeutralPassAvailable

    // ── Module Readiness Information ────────────────────────────────────
    bool   isInitializationCompleted
    bool   isCorePopulated


// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — INPUTS
// ═══════════════════════════════════════════════════════════════════════════
// Only system-level toggles belong here. LONG/SHORT trading parameters
// belong to LONG SETTINGS / SHORT SETTINGS (DATA layer), not to CORE.

grpCore = "⚙ SYSTEM CORE"

i_strategyEnabled       = input.bool(true,  "Enable Strategy",              group = grpCore)
i_longEnabled           = input.bool(true,  "Enable LONG System",          group = grpCore)
i_shortEnabled          = input.bool(true,  "Enable SHORT System",         group = grpCore)
i_experimentalEnabled   = input.bool(false, "Enable Experimental Engine",  group = grpCore)


// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

const string ENGINE_NAME    = "Smart Trend Pro Engine"
const string ENGINE_VERSION = "1.0.0-core"


// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — INSTANCE
// ═══════════════════════════════════════════════════════════════════════════
// A single persistent instance of SystemCore, created once and repopulated
// every bar. This is the sole system-state contract consumed by all
// downstream layers (DATA, DECISION, SIGNAL, EXECUTION, INTERFACE, FUTURE).

var SystemCore core = SystemCore.new(
     engineName                 = ENGINE_NAME
   , engineVersion               = ENGINE_VERSION
   , isRealtime                  = false
   , isHistorical                = false
   , isFirstBar                  = false
   , isLastBar                   = false
   , isNewBar                    = false
   , barIndexCurrent             = 0
   , isDataReady                 = false
   , isMTFDataReady               = false
   , isDataInvalid               = false
   , isLongEnabled               = false
   , isShortEnabled              = false
   , isStrategyEnabled           = false
   , isExperimentalEngineEnabled = false
   , hasPosition                 = false
   , positionDirection           = "flat"
   , positionSize                = 0.0
   , isFlat                      = true
   , isFailSafeTriggered         = false
   , isNeutralPassAvailable      = false
   , isInitializationCompleted   = false
   , isCorePopulated             = false
   )


// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — POPULATION
// ═══════════════════════════════════════════════════════════════════════════
// Populates the SystemCore instance on every bar. This function must remain
// the single source of truth for system state; no other module is permitted
// to write into SystemCore fields.

populateSystemCore(SystemCore c) =>
    // Runtime Information
    c.isRealtime   := barstate.isrealtime
    c.isHistorical := not barstate.isrealtime

    // Bar State Information
    c.isFirstBar      := barstate.isfirst
    // NOTE: bar_index == last_bar_index is used instead of barstate.islast.
    // barstate.islast in a strategy() requires calc_on_every_tick = true,
    // which would force tick-by-tick recalculation and risk repainting.
    // last_bar_index gives the equivalent "last bar" semantic while keeping
    // the engine confirmed-bar-only (non-repainting) by design.
    c.isLastBar        := bar_index == last_bar_index
    c.isNewBar          := barstate.isnew
    c.barIndexCurrent   := bar_index

    // Data Availability Information
    bool dataInvalid   = na(close) or na(open) or na(high) or na(low)
    c.isDataInvalid    := dataInvalid
    c.isDataReady       := not dataInvalid and bar_index > 0
    c.isMTFDataReady     := not dataInvalid  // extended by DATA layer when MTF requests exist

    // Strategy State Information
    c.isStrategyEnabled            := i_strategyEnabled
    c.isLongEnabled                 := i_strategyEnabled and i_longEnabled
    c.isShortEnabled                := i_strategyEnabled and i_shortEnabled
    c.isExperimentalEngineEnabled   := i_experimentalEnabled

    // Global Execution Information
    float posSize = strategy.position_size
    c.positionSize      := posSize
    c.hasPosition        := posSize != 0.0
    c.isFlat              := posSize == 0.0
    c.positionDirection   := posSize > 0 ? "long" : posSize < 0 ? "short" : "flat"

    // Fail Safe Information
    c.isFailSafeTriggered      := dataInvalid
    c.isNeutralPassAvailable    := not dataInvalid and not c.isFirstBar

    // Module Readiness Information
    c.isCorePopulated             := true
    c.isInitializationCompleted    := c.isCorePopulated and not c.isFirstBar

    c


// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CORE — EXECUTION (called once per bar, first in the pipeline)
// ═══════════════════════════════════════════════════════════════════════════

populateSystemCore(core)

// ═══════════════════════════════════════════════════════════════════════════
// COMPILER REQUIREMENT — NOT A VISUAL ENGINE IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════
// Pine Script requires every strategy() to contain at least one visual output
// call (plot/bgcolor/table/etc.), or it will not compile — regardless of
// whether the module has any reason to draw anything yet. VISUAL ENGINE and
// PLOTS ENGINE are future, separate layers per the architecture; this single
// data-window-only plot exists purely to satisfy that compiler requirement
// until those layers exist. It has no chart presence and carries no logic.

plot(core.isCorePopulated ? 1 : 0, title = "STPE_CORE_COMPILER_PLACEHOLDER", display = display.data_window)

// ─────────────────────────────────────────────────────────────────────────
// END OF SYSTEM CORE LAYER
// Downstream layers (DATA / DECISION / SIGNAL / EXECUTION / INTERFACE /
// FUTURE) must read state exclusively through the `core` instance above.
// ─────────────────────────────────────────────────────────────────────────
